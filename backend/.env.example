# Copy this file to backend/.env. It overrides values from the repository root .env.

NODE_ENV=development
PORT=3001
# Set to 1 when exactly one trusted reverse proxy sits in front of the API.
# TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://prism:prism-local-db@localhost:5432/prism
# Email for seed:admin when no --email argument is given.
# ADMIN_EMAIL=

BETTER_AUTH_URL=http://localhost:3001
# The one browser origin allowed to call the API. Required in production.
FRONTEND_URL=http://localhost:5173
# Optional Google sign-in. Set both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

PRISM_SECRETS_FILE=./.secrets.env
# Explicit values override the generated file.
# BETTER_AUTH_SECRET=
# AUTH_OTP_SECRET=
# DOWNLOAD_SIGNING_SECRET=
# AI_CREDENTIAL_ACTIVE_KEY_ID=v1
# AI_CREDENTIAL_ENCRYPTION_KEYS={"v1":"replace-with-a-long-random-secret"}

# Storage. Local files in development. Set the OBJECT_STORE values to use S3-compatible storage.
LOCAL_STORAGE_PATH=./data
# OBJECT_STORE_ENDPOINT=https://s3.example.com
# Browser-facing endpoint for signed downloads, when it differs from OBJECT_STORE_ENDPOINT.
# OBJECT_STORE_PUBLIC_ENDPOINT=https://s3.example.com
# OBJECT_STORE_REGION=us-east-1
# OBJECT_STORE_FORCE_PATH_STYLE=false
# OBJECT_STORE_ACCESS_KEY_ID=
# OBJECT_STORE_SECRET_ACCESS_KEY=
# OBJECT_STORE_BUCKET=

# Mail. Without RESEND_API_KEY, Prism logs mail as suppressed and sends nothing.
# RESEND_API_KEY=
# MAIL_FROM=onboarding@resend.dev

# AI and document search. RAG needs both QDRANT_URL and OPENAI_API_KEY.
# OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
# Needed for Qdrant Cloud, not for the local Compose Qdrant.
# QDRANT_API_KEY=

# Worker health target. Defaults to BETTER_AUTH_URL/health.
# HEALTHCHECK_API_URL=http://localhost:3001/health
