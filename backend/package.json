{
  "name": "@prism/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "check:esm-imports": "node ../scripts/convert-backend-esm-specifiers.mjs --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx src/scripts/verifyDatabase.ts",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" drizzle.config.ts package.json \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" drizzle.config.ts package.json \"tsconfig*.json\"",
    "lint": "eslint src test drizzle.config.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:ai-catalog": "tsx src/scripts/seedAiCatalog.ts",
    "seed:approval-policies": "tsx src/scripts/seedApprovalPolicies.ts",
    "seed:bundled-docx": "tsx src/scripts/seedBundledDocxTemplates.ts",
    "seed:core": "npm run seed:approval-policies && npm run seed:workflows && npm run seed:ai-catalog",
    "seed:docx-templates": "tsx src/scripts/seedDocxTemplates.ts",
    "seed:templates": "tsx src/scripts/seedTemplates.ts",
    "seed:validate": "npm run seed:approval-policies -- --dry-run && npm run seed:workflows -- --dry-run && npm run seed:ai-catalog -- --dry-run && npm run seed:templates -- --dry-run && npm run seed:bundled-docx -- --dry-run && npm run seed:admin -- --dry-run --email admin@example.com",
    "seed:workflows": "tsx src/scripts/seedWorkflows.ts",
    "setup": "npm run build && node dist/scripts/setup.js",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "npm run test:security",
    "test:document-formats": "tsx --test test/document-formats/*.test.ts",
    "test:security": "tsx --test test/security/*.test.ts",
    "test:jobs": "cd .. && vitest run --config vitest.config.mjs --project backend backend/test/unit/job-repository.test.ts backend/test/unit/job-worker.test.ts",
    "test:unit": "vitest run --config ../vitest.config.mjs --project backend",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.55",
    "@ai-sdk/openai-compatible": "^3.0.42",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@prism/protocol": "*",
    "@qdrant/js-client-rest": "^1.19.0",
    "@turbodocx/html-to-docx": "1.22.2",
    "ai": "^7.0.89",
    "better-auth": "1.7.2",
    "cors": "^2.8.5",
    "docx": "^9.5.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.2",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "puppeteer": "^25.0.4",
    "resend": "^6.12.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.10.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "license": "AGPL-3.0-only"
}
